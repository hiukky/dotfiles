#!/bin/bash
set -euo pipefail

# .wslconfig lives on the Windows side (%USERPROFILE%\.wslconfig), read by the
# WSL manager before any distro boots -- it can't be a normal $HOME dotfile.
if ! grep -qi microsoft /proc/version 2>/dev/null; then
  exit 0
fi

WIN_PROFILE="$(wslpath "$(cmd.exe /c "echo %USERPROFILE%" 2>/dev/null | tr -d '\r\n')")"

cat > "$WIN_PROFILE/.wslconfig" <<'EOF'
{{ template "wslconfig" . }}
EOF
